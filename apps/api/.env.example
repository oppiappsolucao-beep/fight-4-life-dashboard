# Neon PostgreSQL — copie do console Neon (botão Connect)
# Toggle ON  → DATABASE_URL (com -pooler no host)
# Toggle OFF → DIRECT_URL (sem -pooler no host)
DATABASE_URL="postgresql://neondb_owner:SUA_SENHA@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:SUA_SENHA@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"

# Servidor
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"

# Tenant da plataforma (hub / painel OPPI Fit)
DEFAULT_TENANT_SLUG="oppifit"
PLATFORM_TENANT_SLUG="oppifit"

# Domínio base do SaaS (subdomínio = academia)
# Ex.: dojotakeda.oppifit.com.br
APP_BASE_DOMAIN="oppifit.com.br"

# Catálogo ExerciseDB (opcional)
# Sem chave: usa a API pública OSS (GIFs 180p) no bootstrap
# Com chave RapidAPI AscendAPI: GIFs em maior resolução
# EXERCISEDB_RAPIDAPI_KEY="sua-chave-rapidapi"
# EXERCISEDB_SYNC="true"
# EXERCISEDB_FORCE_SYNC="false"

# Spoonacular (opcional — enriquecimento futuro de receitas)
# SPOONACULAR_API_KEY="sua-chave-spoonacular"

# Asaas (conta master OPPI Fit)
# Taxa: R$ 1,90 até 100 pagas/academia/ciclo · R$ 1,49 a partir da 101ª paga
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
ASAAS_WALLET_ID=""
# ASAAS_WEBHOOK_TOKEN=""
